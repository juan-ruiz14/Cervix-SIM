# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a GitHub.
HOST=127.0.0.1
PORT=8000
# Token para GET /api/admin/summary (cabecera X-Admin-Token). Vacío = endpoint deshabilitado.
ADMIN_TOKEN=cambia-este-token
# Orígenes permitidos (CORS) si el frontend se aloja aparte, p. ej. https://usuario.github.io
ALLOWED_ORIGINS=
# Base de datos: vacío = memoria (solo desarrollo). Con URI usa MongoDB (Atlas gratuito).
MONGODB_URI=
MONGODB_DB=cervix_sim
# Tutor IA: auto (Gemini si hay clave; si no, Ollama; si falla, texto de respaldo) | gemini | ollama | mock
TUTOR_MODE=auto
# Clave de Google AI Studio. SECRETA: solo en tu .env local o en las variables de Render, nunca en GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opcional: modelo alterno si el principal responde 503 (saturado). Reintentos ante 429/5xx.
GEMINI_FALLBACK_MODEL=
GEMINI_RETRIES=2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a GitHub.
HOST=127.0.0.1
PORT=8000
# Token para GET /api/admin/summary (cabecera X-Admin-Token). Vacío = endpoint deshabilitado.
ADMIN_TOKEN=cambia-este-token
# Orígenes permitidos (CORS) si el frontend se aloja aparte, p. ej. https://usuario.github.io
ALLOWED_ORIGINS=
# Base de datos: vacío = memoria (solo desarrollo). Con URI usa MongoDB (Atlas gratuito).
MONGODB_URI=
MONGODB_DB=cervix_sim
# Tutor IA: auto (Ollama y, si falla, respaldo) | ollama | mock
TUTOR_MODE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
